# Copy this file to .env and fill in PAGERDUTY_API_KEY.
#   cp env.example .env
# .env is git-ignored; never commit real secrets.

# REQUIRED. PagerDuty REST API key with read access.
# Generate one at: PagerDuty → Integrations → API Access Keys → "Create New API Key".
# A read-only key is sufficient. See README.md for step-by-step instructions.
# NOTE: the account must have PagerDuty Analytics enabled, and Analytics data
# lags real-time by up to ~24h.
PAGERDUTY_API_KEY=your_read_only_api_key_here

# OPTIONAL. Comma-separated default service IDs to report on.
# The --service flag overrides this; omit both to report on all visible services.
# These are the razor services (razor-war-room routed).
PAGERDUTY_SERVICE_IDS=PZZG5VN,P27C0CY
